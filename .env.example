# Copy to .env. Development needs none of these; production needs every value marked REQUIRED.
# Never commit .env.

# --- Production (REQUIRED) ---
# Public URL people use, https only in production.
VROS_PUBLIC_URL=https://vros.verkies.co
# Hostname Caddy serves and gets a TLS certificate for. DNS A/AAAA must point at this server.
VROS_SITE_ADDRESS=vros.verkies.co
# Signs sessions and tokens. Generate with: openssl rand -hex 32
VROS_SECRET_KEY=
# Database password. Use URL-safe characters only, e.g.: openssl rand -hex 24
VROS_DB_PASSWORD=

# --- Optional ---
VROS_LOG_LEVEL=INFO
# Local AI for brief wording: "none" (template mode) or "ollama" (start Compose with --profile ai
# and pull the model first). Pick the model by GPU memory: see docs/AI_SPEC.md §5.
VROS_AI_PROVIDER=none
VROS_OLLAMA_MODEL=granite4.2:8b
VROS_BACKUP_KEEP_DAYS=14
# The next-action task created on approval is due this many business days later.
VROS_TASK_DUE_BUSINESS_DAYS=2
# Follow-up engine: an opportunity without a deal is stale, and an open deal inactive, after this
# many days with nothing logged.
VROS_STALE_OPPORTUNITY_DAYS=14
VROS_INACTIVE_DEAL_DAYS=21
# Email (slice 3.4). Nothing is sent unless this is true; each person also connects their own
# mailbox, switches sending on, and passes the SPF/DKIM/DMARC/MX checks.
VROS_EMAIL_SENDING_ENABLED=false
VROS_EMAIL_COMPANY_NAME=Verkies
# Added to emails to US companies (CAN-SPAM). Sending to a US company is refused until it is set.
VROS_EMAIL_POSTAL_ADDRESS=
# Outreach (slice 3.5): LinkedIn notes each person may record per day and per week.
VROS_LINKEDIN_DAILY_LIMIT=15
VROS_LINKEDIN_WEEKLY_LIMIT=80
# Companies House lookups (UK registry facts and directors). Free key: register at
# https://developer.company-information.service.gov.uk, create an application, add a
# "REST" API key. Leave empty to skip; research still works without it.
VROS_COMPANIES_HOUSE_API_KEY=
# Wikidata lookups by official website (no key needed). Set false to switch off.
VROS_WIKIDATA_ENABLED=true
# Web search discovery: start Compose with --profile search and set this to "searxng".
VROS_SEARCH_PROVIDER=none
# Optional; defaults to VROS_SECRET_KEY. Generate with: openssl rand -hex 32
VROS_SEARXNG_SECRET=
